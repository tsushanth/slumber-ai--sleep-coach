<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:ns1="http://schemas.android.com/tools">
    <color name="day_background">#F7F8FC</color>
    <color name="midnight_background">#0B0E1E</color>
    <color name="midnight_moonlight">#4FC3F7</color>
    <string name="app_name">Slumber AI: Sleep Coach</string>
    <string name="channel_description">Monitors your sleep and snoring</string>
    <string name="channel_name">Sleep Tracking</string>
    <string name="notification_text">Monitoring your sleep session…</string>
    <string name="notification_title">Sleep Tracking Active</string>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/day_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SlumberAISleepCoach</item>
    </style>
    <style name="Theme.SlumberAISleepCoach" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/day_background</item>
        <item name="android:statusBarColor">@color/day_background</item>
        <item name="android:navigationBarColor">@color/day_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" ns1:targetApi="o_mr1">true</item>
    </style>
</resources>